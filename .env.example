# =============================================================
#  Configuración del bot de trading — COPIA este archivo a .env
#  y rellena con TUS claves. NUNCA subas el .env al repositorio.
# =============================================================

# --- Broker de EJECUCIÓN ---
# "etoro" = ejecuta en eToro | "alpaca" = ejecuta en Alpaca
BROKER=etoro

# --- Fuente de DATOS de mercado ---
# "yfinance" = Yahoo Finance, SIN claves (por defecto si ejecutas en eToro)
# "etoro"    = feed nativo de eToro (requiere ruta de velas de tu portal)
# "alpaca"   = Alpaca (requiere claves de Alpaca)
# Déjalo vacío para que se elija solo.
DATA_SOURCE=yfinance

# --- Claves de eToro (si BROKER=etoro) ---
# Solicita acceso de desarrollador en https://api-portal.etoro.com
# Empieza SIEMPRE con ETORO_DEMO=true (cuenta virtual).
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_DEMO=true
# Mapa ticker->instrumentId de eToro (los IDs los ves en tu portal eToro).
# eToro NO usa "TSLA", usa un número. Formato: SIMBOLO:ID separados por comas.
ETORO_INSTRUMENTS=TSLA:1001,NVDA:1002,BTC/USD:100000

# --- Claves de Alpaca (SOLO si usas Alpaca para ejecución o datos) ---
# Gratis en https://alpaca.markets (cuenta Paper Trading). Si operas en eToro
# con datos de yfinance, puedes dejarlas vacías.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Estrategia y watchlist ---
# Símbolos separados por comas. Cripto lleva "/" (BTC/USD). Acciones/ETF no (AAPL, SPY).
WATCHLIST=BTC/USD,ETH/USD,AAPL,SPY

# Estrategia: "sma" (tendencia, velas diarias) o "intraday" (RSI, velas de minutos)
STRATEGY=sma

# --- Parámetros SMA (si STRATEGY=sma) ---
SMA_FAST=10
SMA_SLOW=30

# --- Parámetros intradía (si STRATEGY=intraday) ---
INTRADAY_MINUTES=5     # tamaño de vela en minutos (5, 15, ...)
RSI_PERIOD=14
RSI_OVERSOLD=30        # compra al salir de sobreventa
RSI_OVERBOUGHT=70      # cierra al salir de sobrecompra
# Gestión de riesgo (solo intradía):
RISK_PCT=1.0           # % del capital a arriesgar por operación
SL_ATR_MULT=1.5        # stop-loss = entrada - 1.5 x ATR
TP_ATR_MULT=2.5        # take-profit = entrada + 2.5 x ATR

# --- Gestión de riesgo ---
# Dinero (en USD) a invertir por operación de apertura.
TRADE_NOTIONAL_USD=100
# Nº máximo de posiciones abiertas a la vez.
MAX_OPEN_POSITIONS=4

# --- Ejecución ---
# Segundos entre cada ciclo de revisión del bot.
LOOP_INTERVAL_SECONDS=300

# --- Análisis de noticias con IA (Claude) ---
# true = usa Claude para entender las noticias de verdad (no contar palabras).
# Requiere instalar 'anthropic' y una clave de API de Anthropic.
USE_AI_NEWS=false
ANTHROPIC_API_KEY=
# Modelo a usar (claude-opus-4-8 = máxima calidad; claude-haiku-4-5 = más barato).
AI_MODEL=claude-opus-4-8
