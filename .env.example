# =============================================================
#  Configuración del bot de trading — COPIA este archivo a .env
#  y rellena con TUS claves. NUNCA subas el .env al repositorio.
# =============================================================

# --- Claves de Alpaca ---
# Consíguelas gratis en https://alpaca.markets (cuenta Paper Trading).
# Panel -> Home -> "Generate New Keys". Usa las claves de PAPER, no las live.
ALPACA_API_KEY=tu_api_key_aqui
ALPACA_SECRET_KEY=tu_secret_key_aqui

# --- Claves de eToro (opcional, para el adaptador de eToro) ---
# Solicita acceso de desarrollador en https://api-portal.etoro.com
# Empieza SIEMPRE con ETORO_DEMO=true (cuenta virtual).
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_DEMO=true

# --- Modo de operación (Alpaca) ---
# true  = paper trading (dinero ficticio)  <-- DÉJALO EN true PARA EMPEZAR
# false = dinero REAL (solo cuando tu estrategia esté validada)
ALPACA_PAPER=true

# --- Estrategia y watchlist ---
# Símbolos separados por comas. Cripto lleva "/" (BTC/USD). Acciones/ETF no (AAPL, SPY).
WATCHLIST=BTC/USD,ETH/USD,AAPL,SPY

# Estrategia: "sma" (tendencia, velas diarias) o "intraday" (RSI, velas de minutos)
STRATEGY=sma

# --- Parámetros SMA (si STRATEGY=sma) ---
SMA_FAST=10
SMA_SLOW=30

# --- Parámetros intradía (si STRATEGY=intraday) ---
INTRADAY_MINUTES=5     # tamaño de vela en minutos (5, 15, ...)
RSI_PERIOD=14
RSI_OVERSOLD=30        # compra al salir de sobreventa
RSI_OVERBOUGHT=70      # cierra al salir de sobrecompra
# Gestión de riesgo (solo intradía):
RISK_PCT=1.0           # % del capital a arriesgar por operación
SL_ATR_MULT=1.5        # stop-loss = entrada - 1.5 x ATR
TP_ATR_MULT=2.5        # take-profit = entrada + 2.5 x ATR

# --- Gestión de riesgo ---
# Dinero (en USD) a invertir por operación de apertura.
TRADE_NOTIONAL_USD=100
# Nº máximo de posiciones abiertas a la vez.
MAX_OPEN_POSITIONS=4

# --- Ejecución ---
# Segundos entre cada ciclo de revisión del bot.
LOOP_INTERVAL_SECONDS=300
